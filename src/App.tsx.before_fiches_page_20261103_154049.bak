import { useCallback, useEffect, useRef, useState } from 'react'
import { useLocation, useNavigate } from 'react-router-dom'
import './App.css'
import NewFicheForm from './NewFicheForm'
import UserCrud from './UserCrud'
import Mailbox from './Mailbox'
import { useAuth } from './contexts/AuthContext'
import { usePush } from './contexts/PushContext'
import { useAppData } from './hooks/useAppData'
import { useSupervisorActions } from './hooks/useSupervisorActions'
import { useFichesPagination } from './hooks/useFichesPagination'
import Icon from './components/shared/Icon'
import KpiCard from './components/dashboard/KpiCard'
import EvolutionPanel from './components/dashboard/EvolutionPanel'
import DashboardHero from './components/dashboard/DashboardHero'
import NotificationPanel from './components/dashboard/NotificationPanel'
import PreventionBanner from './components/dashboard/PreventionBanner'
import FicheTable from './components/fiches/FicheTable'
import StructureRow from './components/structures/StructureRow'
import StructurePanel from './components/structures/StructurePanel'
import ProfilePage from './components/account/ProfilePage'
import HelpPage from './components/account/HelpPage'
import ComingSoon from './components/shared/ComingSoon'
import LoginPage from './components/auth/LoginPage'
import { getMonthlyStats } from './utils/dashboardStats'
import {
  navigation,
  settingsNavigation,
  accountPages,
  supervisorPages,
  pageSubtitles,
  pagePaths,
  pathPages,
} from './config/navigation'

import type { Page } from './config/navigation'

import { api } from './services/api'

import type {
  PagedFiches,
} from './types'


function App() {
  const navigate = useNavigate()
  const location = useLocation()

  const {
    token,
    user,
    setUser,
    login,
    clearSession,
  } = useAuth()

  const {
    pushEnabled,
    pushBusy,
    unreadNotifications,
    setUnreadNotifications,
    activatePush,
    disablePush,
    disablePushForLogout,
  } = usePush()

  const page: Page = pathPages[location.pathname] || 'dashboard'

  const setPage = useCallback((nextPage: Page) => {
    navigate(pagePaths[nextPage])
  }, [navigate])

  useEffect(() => {
    if (!token) {
      if (location.pathname !== '/login') {
        navigate('/login', { replace: true })
      }
      return
    }

    if (location.pathname === '/' || location.pathname === '/login') {
      navigate('/dashboard', { replace: true })
    }
  }, [token, location.pathname, navigate])
  const [refreshKey, setRefreshKey] = useState(0)
  const isSupervisor = user?.role === 'superviseur'
  const visibleNavigation = navigation.filter((item) => {
    if (isSupervisor) {
      return item.id === 'dashboard'
        || item.id === 'fiches'
        || item.id === 'mailbox'
    }
    return true
  })
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [showPassword, setShowPassword] = useState(false)
  const [loginError, setLoginError] = useState('')
  const [busy, setBusy] = useState(false)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState('')
  const [search, setSearch] = useState('')
  const [pageOffset, setPageOffset] = useState(0)
  const [showNewFiche, setShowNewFiche] = useState(false)
  const [menuOpen, setMenuOpen] = useState(() => typeof window === 'undefined' || window.innerWidth > 900)
  const [settingsOpen, setSettingsOpen] = useState(() =>
    settingsNavigation.some((item) => item.id === pathPages[location.pathname]),
  )
  const [profileMenuOpen, setProfileMenuOpen] = useState(false)
  const profileRef = useRef<HTMLDivElement>(null)
  useEffect(() => {
    if (!profileMenuOpen) return
    const onPointerDown = (event: MouseEvent) => {
      if (profileRef.current && !profileRef.current.contains(event.target as Node)) {
        setProfileMenuOpen(false)
      }
    }
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') setProfileMenuOpen(false)
    }
    document.addEventListener('mousedown', onPointerDown)
    document.addEventListener('keydown', onKeyDown)
    return () => {
      document.removeEventListener('mousedown', onPointerDown)
      document.removeEventListener('keydown', onKeyDown)
    }
  }, [profileMenuOpen])
  const pageSize = 10
  const {
    pagedFiches,
    setPagedFiches,
    totalFiches,
    setTotalFiches,
  } = useFichesPagination({
    token,
    page,
    search,
    pageOffset,
    pageSize,
    refreshKey,
    setLoading,
    setError,
  })
    const handleInvalidSession = useCallback(async () => {
    await disablePushForLogout()
    clearSession()
  }, [disablePushForLogout, clearSession])

  const {
    fiches,
    users,
    regions,
    prefectures,
    communes,
    formations,
    loadData,
    clearSessionData,
  } = useAppData({
    setUser,
    setLoading,
    setError,
    onSessionInvalid: handleInvalidSession,
  })
  const { handleSupervisorAction } = useSupervisorActions({
    token,
    role: user?.role,
    setBusy,
    setError,
    loadData,
    onRefresh: () => setRefreshKey((value) => value + 1),
  })
  const logout = useCallback(async () => {
    await handleInvalidSession()
    clearSessionData()
  }, [handleInvalidSession, clearSessionData])

  useEffect(() => {
    if (token) void loadData(token)
  }, [token, loadData])

  useEffect(() => {
      if (
  isSupervisor
  && !supervisorPages.includes(page)
) {
      setPage('dashboard')
    }
  }, [isSupervisor, page])
  async function handleLogin(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setBusy(true)
    setLoginError('')

    try {
      await login(email.trim(), password)
      setPassword('')
    } catch (e) {
      setLoginError(
        e instanceof Error
          ? e.message
          : 'Impossible de contacter le serveur.',
      )
    } finally {
      setBusy(false)
    }
  }
  
  if (!token) {
  return (
    <LoginPage
      email={email}
      setEmail={setEmail}
      password={password}
      setPassword={setPassword}
      showPassword={showPassword}
      setShowPassword={setShowPassword}
      loginError={loginError}
      error={error}
      busy={busy}
      onSubmit={handleLogin}
    />
  )
}

  const pageTitle = [...navigation, ...settingsNavigation, ...accountPages]
    .find((item) => item.id === page)?.label || 'Tableau de bord'
  const monthlyStats = getMonthlyStats(fiches)
  const currentMonth = monthlyStats[monthlyStats.length - 1]
  const previousMonth = monthlyStats[monthlyStats.length - 2]
  const validatedCount = fiches.filter((f) => f.validation_confirmee).length
  const structuresCount = isSupervisor
    ? new Set(fiches.map((f) => f.formation_sanitaire_id)).size
    : formations.length
  const userRoleLabel = (user?.role || 'Compte connecté').replace(/_/g, ' ')
  const closeMenuOnMobile = () => {
    if (typeof window !== 'undefined' && window.innerWidth <= 900) setMenuOpen(false)
  }
  const openAccountPage = (target: 'profil' | 'aide') => {
    setProfileMenuOpen(false)
    setSearch('')
    setPage(target)
  }
  return (
    <div className={`app-shell ${menuOpen ? '' : 'menu-closed'}`}>
      <div className="sidebar-backdrop" onClick={() => setMenuOpen(false)} />
      <aside className="sidebar">
        <div className="sidebar-brand">
          <img className="sidebar-emblem" src="/scdip-embleme.png" alt="Emblème SCDIP-PNLP" />
          <div className="sidebar-wordmark">
            <img src="/scdip-embleme.png" alt="" />
            <strong>SCDIP<span>-PNLP</span></strong>
          </div>
          <small>Ensemble contre le paludisme</small>
        </div>
        <nav>
          {visibleNavigation.map((item) => (
            <button key={item.id} className={`nav-item ${page === item.id ? 'active' : ''}`}
              onClick={() => { setPage(item.id); setSearch(''); closeMenuOnMobile() }}>
              <span className="nav-icon"><Icon name={item.icon} /></span>
              <span className="nav-label">{item.label}</span>
              {item.id === 'mailbox' && unreadNotifications > 0 && (
                <span className="notification-badge">
                  {unreadNotifications > 99 ? '99+' : unreadNotifications}
                </span>
              )}
            </button>
          ))}
          <div className="nav-group">
            <button
              type="button"
              className={`nav-item nav-parent ${settingsNavigation.some((item) => item.id === page) ? 'has-active' : ''}`}
              aria-expanded={settingsOpen}
              aria-controls="settings-submenu"
              onClick={() => setSettingsOpen((value) => !value)}
            >
              <span className="nav-icon"><Icon name="settings" /></span>
              <span className="nav-label">Paramètres</span>
              <span className={`nav-caret ${settingsOpen ? 'is-open' : ''}`}><Icon name="chevron" /></span>
            </button>
            {settingsOpen && (
              <div className="nav-submenu" id="settings-submenu">
                {settingsNavigation.map((item) => (
                  <button
                    key={item.id}
                    type="button"
                    className={`nav-subitem ${page === item.id ? 'active' : ''}`}
                    onClick={() => { setPage(item.id); setSearch(''); closeMenuOnMobile() }}
                  >
                    <Icon name={item.icon} />
                    <span>{item.label}</span>
                  </button>
                ))}
              </div>
            )}
          </div>
        </nav>
        <div className="nav-separator" />
        <button className="nav-item nav-logout" title="Se déconnecter" onClick={logout}>
          <span className="nav-icon"><Icon name="logout" /></span>
          <span className="nav-label">Déconnexion</span>
        </button>
        <div className="sidebar-bottom">
          <p className="sidebar-slogan">Un Togo sans paludisme,<br />c’est possible !</p>
          <img className="sidebar-flag" src="/scdip-drapeau.png" alt="" />
        </div>
      </aside>
      <main className="main-panel">
        <header className="topbar">
          <button type="button" className="menu-toggle" aria-label="Afficher ou masquer le menu" onClick={() => setMenuOpen((value) => !value)}>
            <Icon name="menu" />
          </button>
          <div className="topbar-title">
            <h1>SCDIP-PNLP</h1>
            <p>Système de collecte des données individuelles du paludisme</p>
          </div>
          <div className="top-actions">
            <button
              type="button"
              className="icon-button"
              title="Actualiser les données"
              aria-label="Actualiser les données"
              onClick={() => void loadData(token)}
              disabled={loading}
            >
              <span className={loading ? 'spin' : ''}><Icon name="refresh" /></span>
            </button>
            <button
              type="button"
              className={`bell-button ${pushEnabled ? '' : 'is-off'}`}
              onClick={() => {
                if (pushEnabled) {
                  void disablePush()
                } else {
                  void activatePush()
                }
              }}
              disabled={pushBusy}
              title={
                pushEnabled
                  ? 'Désactiver les notifications'
                  : 'Activer les notifications'
              }
              aria-label={
                pushEnabled
                  ? 'Désactiver les notifications'
                  : 'Activer les notifications'
              }
            >
              <Icon name="bell" />
              {unreadNotifications > 0 && (
                <span className="bell-badge">{unreadNotifications > 99 ? '99+' : unreadNotifications}</span>
              )}
            </button>
            <span className="top-divider" />
            <div className="user-pill" ref={profileRef}>
              <span className="user-avatar"><Icon name="user" /></span>
              <span className="user-meta">
                <strong>{user ? `${user.prenom} ${user.nom}` : 'Utilisateur'}</strong>
                <small>{userRoleLabel}</small>
              </span>
              <button
                type="button"
                className={`user-chevron ${profileMenuOpen ? 'is-open' : ''}`}
                aria-label="Ouvrir le menu du profil"
                aria-haspopup="menu"
                aria-expanded={profileMenuOpen}
                onClick={() => setProfileMenuOpen((value) => !value)}
              >
                <Icon name="chevron" />
              </button>
              {profileMenuOpen && (
                <div className="profile-menu" role="menu">
                  <button type="button" role="menuitem" onClick={() => openAccountPage('profil')}>
                    <Icon name="user" /> Profil
                  </button>
                  <button type="button" role="menuitem" onClick={() => openAccountPage('aide')}>
                    <Icon name="help" /> Aide
                  </button>
                  <div className="profile-menu-sep" />
                  <button
                    type="button"
                    role="menuitem"
                    className="is-danger"
                    onClick={() => { setProfileMenuOpen(false); void logout() }}
                  >
                    <Icon name="logout" /> Se déconnecter
                  </button>
                </div>
              )}
            </div>
          </div>
        </header>
        <div className="content">
          {page !== 'dashboard' && (
            <div className="page-heading">
              <div>
                <span className="eyebrow">SUIVI ET PILOTAGE</span>
                <h1>{pageTitle}</h1>
                <p className="muted">
                  {pageSubtitles[page] ?? 'Consultez les structures administratives et sanitaires.'}
                </p>
              </div>
              <div className="date-chip">{new Intl.DateTimeFormat('fr-FR', {
                day: '2-digit', month: 'long', year: 'numeric',
              }).format(new Date())}</div>
            </div>
          )}
          {error && <div className="alert error">{error}</div>}
          {page === 'dashboard' && (
            <>
              <DashboardHero onSeeDashboard={() => document.getElementById('dashboard-stats')?.scrollIntoView({ behavior: 'smooth', block: 'start' })} />
              <div className="kpi-grid" id="dashboard-stats">
                <KpiCard
                  tone="blue"
                  icon="clipboard"
                  label={<>Fiches saisies<br />ce mois</>}
                  value={currentMonth.total}
                  current={currentMonth.total}
                  previous={previousMonth.total}
                  series={monthlyStats.map((item) => item.total)}
                />
                <KpiCard
                  tone="green"
                  icon="check"
                  label="Fiches validées"
                  value={validatedCount}
                  current={currentMonth.validated}
                  previous={previousMonth.validated}
                  series={monthlyStats.map((item) => item.validated)}
                />
                <KpiCard
                  tone="orange"
                  icon="bell"
                  label={<>Notifications<br />non lues</>}
                  value={unreadNotifications}
                  onClick={() => setPage('mailbox')}
                />
                <KpiCard
                  tone="violet"
                  icon="hospital"
                  label="Structures sanitaires"
                  value={structuresCount}
                  onClick={isSupervisor ? undefined : () => setPage('structures')}
                />
              </div>
              <div className="dashboard-insights">
                <EvolutionPanel fiches={fiches} />
                <NotificationPanel
                  unread={unreadNotifications}
                  pushEnabled={pushEnabled}
                  fiches={fiches}
                  onOpenMailbox={() => setPage('mailbox')}
                />
              </div>
              <PreventionBanner />
              <section className="panel recent-panel">
                <div className="panel-heading">
                  <div><h2>Fiches récentes</h2><p className="muted">Dernières fiches retournées par le serveur</p></div>
                  <button className="text-button" onClick={() => setPage('fiches')}>Voir les fiches <span>→</span></button>
                </div>
                <FicheTable
                  fiches={fiches.slice(0, 6)}
                  loading={loading}
                  role={user?.role || ''}
                  busy={busy}
                  onAction={handleSupervisorAction}
                  token={token}
                  onRefresh={async () => {
                    await loadData(token)
                    setRefreshKey((value) => value + 1)
                  }}
                />
              </section>
              {isSupervisor ? (
                <section className="panel">
                  <div className="panel-heading">
                    <div>
                      <h2>Votre espace de supervision</h2>
                      <p className="muted">
                        Examinez les fiches de votre périmètre, demandez des corrections
                        et validez les fiches conformes.
                      </p>
                    </div>
                  </div>
                  <button
                    type="button"
                    className="primary-button"
                    onClick={() => setPage('fiches')}
                  >
                    Accéder aux fiches <span>→</span>
                  </button>
                </section>
              ) : (
                <div className="bottom-grid">
                  <section className="panel">
                    <div className="panel-heading">
                      <div>
                        <h2>Structures administratives</h2>
                        <p className="muted">Données disponibles via l’API</p>
                      </div>
                    </div>
                    <div className="structure-list">
                      <StructureRow label="Régions" count={regions.length} icon="◈" />
                      <StructureRow label="Préfectures" count={prefectures.length} icon="⌖" />
                      <StructureRow label="Communes" count={communes.length} icon="⌂" />
                      <StructureRow label="Formations sanitaires" count={formations.length} icon="✚" />
                    </div>
                  </section>
                  <section className="panel access-panel">
                    <div className="panel-heading">
                      <div>
                        <h2>Accès rapide</h2>
                        <p className="muted">Gestion des données</p>
                      </div>
                    </div>
                    <button className="quick-link" onClick={() => setPage('fiches')}>
                      <span className="quick-icon blue">▤</span>
                      <span>
                        <strong>Consulter les fiches</strong>
                        <small>Accéder aux données de collecte</small>
                      </span>
                      <b>→</b>
                    </button>
                    <button className="quick-link" onClick={() => setPage('users')}>
                      <span className="quick-icon violet">♙</span>
                      <span>
                        <strong>Utilisateurs</strong>
                        <small>Voir les comptes accessibles</small>
                      </span>
                      <b>→</b>
                    </button>
                    <button className="quick-link" onClick={() => setPage('structures')}>
                      <span className="quick-icon green">⌂</span>
                      <span>
                        <strong>Structures</strong>
                        <small>Voir les structures sanitaires</small>
                      </span>
                      <b>→</b>
                    </button>
                  </section>
                </div>
              )}
            </>
          )}
          {page === 'fiches' && (
            <section className="panel list-panel fiches-panel">
              <div className="panel-heading list-heading">
                <div className="list-heading-main">
                  <span className="list-icon"><Icon name="fiches" /></span>
                  <div>
                    <h2>Registre des fiches</h2>
                    <p className="muted">
                      {totalFiches} fiche(s) au total
                      {totalFiches > 0
                        ? ` — ${pageOffset + 1}–${Math.min(pageOffset + pageSize, totalFiches)} affichée(s)`
                        : ''}
                    </p>
                  </div>
                </div>
                <div className="nf-header-actions">
                  <label className="list-search">
                    <Icon name="search" />
                    <input
                      className="search-input"
                      value={search}
                      onChange={(e) => {
                        setSearch(e.target.value)
                        setPageOffset(0)
                      }}
                      placeholder="Rechercher une fiche…"
                      aria-label="Rechercher une fiche"
                    />
                  </label>
                {user?.role === 'agent_fs' && (
                  <button type="button" className="nf-plus-button" aria-label="Créer une nouvelle fiche" title="Nouvelle fiche paludisme" onClick={() => setShowNewFiche((value) => !value)}>{showNewFiche ? '×' : '+'}</button>
                )}
              </div>
              </div>
              {showNewFiche && user?.role === 'agent_fs' && token && (
                <NewFicheForm
                  token={token}
                  onCancel={() => setShowNewFiche(false)}
                  onCreated={async () => {
                    setShowNewFiche(false)
                    setSearch('')
                    setPageOffset(0)
                    const refreshed = await api<PagedFiches>('/api/v1/fiches/paginees?limit=10&offset=0', token)
                    setPagedFiches(refreshed.items)
                    setTotalFiches(refreshed.total)
                  }}
                />
              )}
              <FicheTable
                fiches={pagedFiches}
                loading={loading}
                role={user?.role || ''}
                busy={busy}
                onAction={handleSupervisorAction}
                token={token}
                onRefresh={async () => {
                  await loadData(token)
                  setRefreshKey((value) => value + 1)
                }}
              />
              <div className="table-foot pagination-controls">
                <span>
                  Page {Math.floor(pageOffset / pageSize) + 1} sur {Math.max(1, Math.ceil(totalFiches / pageSize))}
                </span>
                <div>
                  <button type="button" className="secondary-button"
                    disabled={loading || pageOffset === 0}
                    onClick={() => setPageOffset((offset) => Math.max(0, offset - pageSize))}>
                    Précédent
                  </button>
                  <button type="button" className="secondary-button"
                    disabled={loading || pageOffset + pageSize >= totalFiches}
                    onClick={() => setPageOffset((offset) => offset + pageSize)}>
                    Suivant
                  </button>
                </div>
              </div>
            </section>
          )}
          {page === 'mailbox' && (
            <Mailbox
              token={token}
              onUnreadCountChange={setUnreadNotifications}
            />
          )}
          {page === 'users' && (
            <UserCrud
              token={token}
              users={users}
              regions={regions}
              prefectures={prefectures}
              communes={communes}
              formations={formations}
              currentUserId={user?.id}
              onRefresh={async () => {
                await loadData(token)
              }}
            />
          )}
          {page === 'structures' && (
            <div className="structure-grid list-grid">
              <StructurePanel title="Régions" items={regions} icon="map" />
              <StructurePanel title="Préfectures" items={prefectures} icon="pin" />
              <StructurePanel title="Communes" items={communes} icon="structures" />
              <StructurePanel title="Formations sanitaires" items={formations} icon="hospital" />
            </div>
          )}
          {page === 'journaux' && <ComingSoon icon="journal" text="Le journal des actions sera disponible ici." />}
          {page === 'rapport' && <ComingSoon icon="bars" text="Les rapports seront disponibles ici." />}
          {page === 'export' && <ComingSoon icon="download" text="L’export des données sera disponible ici." />}
          {page === 'profil' && <ProfilePage user={user} roleLabel={userRoleLabel} />}
          {page === 'aide' && <HelpPage />}
          <footer className="footer"><span>SCDIP-PNLP</span><span>Collecte des données individuelles du paludisme</span></footer>
        </div>
      </main>
    </div>
  )
}

export default App

