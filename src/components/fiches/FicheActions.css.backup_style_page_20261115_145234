/* ===== Actions et consultation d'une fiche — style dédié ===== */

.fiche-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.fiche-actions .secondary-button,
.fiche-actions .danger-button {
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 13.5px;
  font-weight: 700;
  white-space: nowrap;
  transition: background 0.15s, color 0.15s, border-color 0.15s, box-shadow 0.15s;
}

.fiche-actions .secondary-button {
  border: 1.5px solid #c3d6ee;
  background: #fff;
  color: #0a63b0;
}

.fiche-actions .secondary-button:hover:not(:disabled) {
  background: #0a63b0;
  border-color: #0a63b0;
  color: #fff;
  box-shadow: 0 6px 14px #0a63b02e;
}

.fiche-actions .danger-button {
  border: 1.5px solid #f1c6c6;
  background: #fff;
  color: #c03a3a;
}

.fiche-actions .danger-button:hover:not(:disabled) {
  background: #d94b4b;
  border-color: #d94b4b;
  color: #fff;
  box-shadow: 0 6px 14px #d94b4b2e;
}

/* Message d'erreur sous les boutons */
.fiche-actions + .alert.error {
  margin: 8px 0 0;
  padding: 8px 12px;
  border-radius: 10px;
  font-size: 13px;
  white-space: normal;
}

/* ---------- Fenêtre « Consulter la fiche » ---------- */
.user-modal-backdrop .fiche-modal {
  width: min(980px, 100%);
}

.user-modal-backdrop .fiche-modal .user-form-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  max-height: 62vh;
  overflow-y: auto;
  padding: 22px 28px 28px;
  margin: 0;
}

/* Chaque donnée devient une « tuile » lecture seule */
.user-modal-backdrop .fiche-modal .nf-field {
  gap: 6px;
  padding: 12px 14px 10px;
  border: 1px solid #e3ebf5;
  border-radius: 12px;
  background: #f7fafd;
}

.user-modal-backdrop .fiche-modal .nf-field > span {
  color: #5a6f93;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.7px;
  text-transform: uppercase;
}

.user-modal-backdrop .fiche-modal .nf-field input {
  min-height: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: #0b2a8a;
  font-size: 16px;
  font-weight: 700;
  cursor: default;
}

.user-modal-backdrop .fiche-modal .nf-field input:focus {
  box-shadow: none;
}

.user-modal-backdrop .fiche-modal .nf-field:focus-within {
  border-color: #0a63b0;
  background: #fff;
}

@media (max-width: 900px) {
  .user-modal-backdrop .fiche-modal .user-form-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .user-modal-backdrop .fiche-modal .user-form-grid {
    grid-template-columns: 1fr;
    padding: 16px;
  }
}
/* Ouverture des détails au clic sur une ligne du registre */
.table-wrap tbody tr.fiche-row-clickable {
  cursor: pointer;
}

.table-wrap tbody tr.fiche-row-clickable:hover {
  background: rgba(59, 130, 246, 0.07);
}

.table-wrap tbody tr.fiche-row-clickable:focus-visible {
  outline: 2px solid var(--primary, #2563eb);
  outline-offset: -2px;
}
/* ==========================================================
   Fenêtre de détails : affichage presque plein écran
   ========================================================== */

.user-modal-backdrop .fiche-modal {
  width: 96vw;
  max-width: 1600px;
  height: 92vh;
  max-height: 92vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 0;
}

.user-modal-backdrop .fiche-modal .fiche-modal-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 22px 30px;
  margin: 0;
  border-bottom: 1px solid #e3ebf5;
  background: #fff;
}

.user-modal-backdrop .fiche-modal .fiche-detail-content {
  flex: 1 1 auto;
  min-height: 0;
  max-height: none;
  overflow-y: auto;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  padding: 24px 30px;
  margin: 0;
  align-content: start;
}

/* Barre fixe en bas de la fenêtre */

.user-modal-backdrop .fiche-modal .fiche-modal-footer {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18px;
  padding: 18px 30px;
  border-top: 1px solid #e3ebf5;
  background: #fff;
  box-shadow: 0 -5px 18px rgba(20, 45, 80, 0.05);
}

.fiche-modal-footer-info {
  display: flex;
  flex-direction: column;
  gap: 5px;
  color: #183153;
  font-size: 14px;
}

.fiche-modal-footer-info span {
  color: #64748b;
  font-size: 12.5px;
}

.fiche-modal-footer-buttons {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10px;
}

.fiche-modal-footer-buttons button {
  min-height: 42px;
}

/* Responsive */

@media (max-width: 900px) {
  .user-modal-backdrop .fiche-modal {
    width: 98vw;
    height: 94vh;
    max-height: 94vh;
  }

  .user-modal-backdrop .fiche-modal .fiche-detail-content {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 18px;
  }

  .user-modal-backdrop .fiche-modal .fiche-modal-header,
  .user-modal-backdrop .fiche-modal .fiche-modal-footer {
    padding: 16px 18px;
  }
}

@media (max-width: 560px) {
  .user-modal-backdrop .fiche-modal .fiche-detail-content {
    grid-template-columns: 1fr;
  }

  .user-modal-backdrop .fiche-modal .fiche-modal-footer {
    align-items: stretch;
  }

  .fiche-modal-footer-buttons {
    justify-content: stretch;
  }

  .fiche-modal-footer-buttons button {
    flex: 1 1 100%;
  }
}

/* ==========================================================
   AMELIORATION CONFORT : FENETRE DE DETAIL DE LA FICHE
   ========================================================== */

/* Fond de la fenêtre */
.user-modal-backdrop:has(.fiche-modal) {
  padding: 1.5vh 1vw;
  align-items: center;
  justify-content: center;
}

/* Fenêtre presque plein écran */
.user-modal-backdrop .fiche-modal {
  width: 98vw !important;
  max-width: 1800px !important;
  height: 96vh !important;
  max-height: 96vh !important;
  min-height: 0;
  border-radius: 18px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* En-tête toujours visible */
.user-modal-backdrop .fiche-modal .fiche-modal-header {
  flex-shrink: 0;
  min-height: 86px;
  padding: 18px 30px;
  background: linear-gradient(110deg, #f0f6ff, #ffffff);
}

.user-modal-backdrop .fiche-modal .fiche-modal-header h2 {
  margin: 0 0 6px;
  color: #0b2a8a;
  font-size: 23px;
  font-weight: 800;
}

.user-modal-backdrop .fiche-modal .fiche-modal-header p {
  margin: 0;
  font-size: 13px;
}

/* Zone des informations */
.user-modal-backdrop .fiche-modal .fiche-detail-content {
  flex: 1 1 auto;
  min-height: 0;
  max-height: none !important;
  overflow-y: auto;
  overflow-x: hidden;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  align-content: start;
  align-items: stretch;
  gap: 12px;
  padding: 20px 26px;
  margin: 0;
  background: #f6f9fd;
}

/* Cartes des champs */
.user-modal-backdrop .fiche-modal .fiche-detail-content .nf-field {
  min-width: 0;
  min-height: 66px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 7px;
  padding: 11px 14px;
  border: 1px solid #e0e9f4;
  border-radius: 11px;
  background: #ffffff;
  box-shadow: 0 2px 5px rgba(20, 50, 90, 0.035);
  transition: border-color 0.15s, box-shadow 0.15s;
}

.user-modal-backdrop .fiche-modal .fiche-detail-content .nf-field:hover {
  border-color: #a9c8ed;
  box-shadow: 0 3px 10px rgba(20, 80, 150, 0.07);
}

.user-modal-backdrop .fiche-modal .fiche-detail-content .nf-field > span {
  color: #64748b;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.55px;
  line-height: 1.35;
  text-transform: uppercase;
}

.user-modal-backdrop .fiche-modal .fiche-detail-content .nf-field input {
  width: 100%;
  min-width: 0;
  min-height: 20px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #12366d;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  overflow: hidden;
}

.user-modal-backdrop .fiche-modal .fiche-detail-content .nf-field input:focus {
  outline: none;
  box-shadow: none;
}

/* Barre d'actions toujours visible en bas */
.user-modal-backdrop .fiche-modal .fiche-modal-footer {
  flex-shrink: 0;
  min-height: 76px;
  padding: 14px 26px;
  background: #ffffff;
  border-top: 1px solid #dce6f2;
  box-shadow: 0 -4px 14px rgba(20, 45, 80, 0.045);
  z-index: 2;
}

.user-modal-backdrop .fiche-modal .fiche-modal-footer-buttons {
  gap: 10px;
}

.user-modal-backdrop .fiche-modal .fiche-modal-footer-buttons button {
  min-height: 42px;
  padding: 10px 18px;
  border-radius: 999px;
  font-weight: 750;
}

/* Ecrans moyens */
@media (max-width: 1200px) {
  .user-modal-backdrop .fiche-modal .fiche-detail-content {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }
}

/* Tablettes */
@media (max-width: 850px) {
  .user-modal-backdrop .fiche-modal {
    width: 98vw !important;
    height: 96vh !important;
    max-height: 96vh !important;
  }

  .user-modal-backdrop .fiche-modal .fiche-detail-content {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    padding: 16px;
    gap: 10px;
  }

  .user-modal-backdrop .fiche-modal .fiche-modal-header {
    padding: 16px 20px;
  }

  .user-modal-backdrop .fiche-modal .fiche-modal-footer {
    padding: 12px 16px;
  }
}

/* Téléphones */
@media (max-width: 560px) {
  .user-modal-backdrop:has(.fiche-modal) {
    padding: 0;
  }

  .user-modal-backdrop .fiche-modal {
    width: 100vw !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    border-radius: 0;
  }

  .user-modal-backdrop .fiche-modal .fiche-detail-content {
    grid-template-columns: 1fr !important;
    padding: 12px;
  }

  .user-modal-backdrop .fiche-modal .fiche-modal-header {
    padding: 14px;
  }

  .user-modal-backdrop .fiche-modal .fiche-modal-header h2 {
    font-size: 18px;
  }

  .user-modal-backdrop .fiche-modal .fiche-modal-footer {
    padding: 12px;
  }

  .user-modal-backdrop .fiche-modal .fiche-modal-footer-buttons {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
  }

  .user-modal-backdrop .fiche-modal .fiche-modal-footer-buttons button {
    width: 100%;
  }
}

/* ==========================================================
   FICHE SCDIP : MODE PLEIN ECRAN REEL
   La fenêtre occupe toute la surface de l'écran.
   ========================================================== */

