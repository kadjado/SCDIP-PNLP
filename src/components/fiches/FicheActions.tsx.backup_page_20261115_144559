import { useEffect, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import './FicheActions.css'
import { api, ApiError } from '../../services/api'
import type { Fiche } from '../../types'

type FicheActionType =
  | 'valider'
  | 'demander-correction'
  | 'traiter-correction'

type FicheActionsProps = {
  ficheId: string
  numeroFiche: string
  token: string
  role: string
  onRefresh: () => Promise<void>
  onSessionInvalid: () => Promise<void>
  autoOpen?: boolean
  hideActions?: boolean
  onAutoOpenClose?: () => void
  fiche?: Fiche
  onAction?: (fiche: Fiche, action: FicheActionType) => void
  busy?: boolean
  showWorkflowActions?: boolean
}

type FicheDetail = Record<string, unknown>

const labels: Record<string, string> = {
  numero_fiche: 'Numéro de fiche',
  date_consultation: 'Date de consultation',
  date_saisie: 'Date de saisie',
  num_oc: 'Numéro OC',
  mois: 'Mois',
  age: 'Âge',
  sexe: 'Sexe',
  grossesse: 'Grossesse',
  tpi1: 'TPI1',
  tpi2: 'TPI2',
  type_consultation: 'Type de consultation',
  fievre: 'Fièvre',
  motif_consultation: 'Motif de consultation',
  ge_realisee: 'GE réalisée',
  type_ge: 'Type de GE',
  charge_sigep: 'Charge SIGEP',
  tdr_realise: 'TDR réalisé',
  type_tdr_id: 'Type de TDR',
  resultat_tdr: 'Résultat TDR',
  numero_laboratoire: 'Numéro de laboratoire',
  diagnostic: 'Diagnostic',
  asaq: 'ASAQ',
  arlm: 'ARLM',
  quinine_comprime: 'Quinine comprimé',
  quinine_injectable: 'Quinine injectable',
  artesunate_injectable: 'Artésunate injectable',
  autre_traitement: 'Autre traitement',
  hospitalise: 'Hospitalisé',
  date_sortie: 'Date de sortie',
  issue_hospitalisation: 'Issue de l’hospitalisation',
  validation_confirmee: 'Validation confirmée',
  version: 'Version',
}

function displayValue(value: unknown): string {
  if (value === null || value === undefined || value === '') {
    return 'Non renseigné'
  }

  if (typeof value === 'boolean') {
    return value ? 'Oui' : 'Non'
  }

  if (typeof value === 'object') {
    return JSON.stringify(value)
  }

  return String(value)
}

export default function FicheActions({
  ficheId,
  numeroFiche,
  token,
  role,
  onRefresh,
  onSessionInvalid,
  autoOpen = false,
  hideActions = false,
  onAutoOpenClose,
  fiche,
  onAction,
  busy = false,
  showWorkflowActions = false,
}: FicheActionsProps) {
  const [detail, setDetail] = useState<FicheDetail | null>(null)
  const [showDetail, setShowDetail] = useState(false)
  const [loading, setLoading] = useState(false)
  const [deleting, setDeleting] = useState(false)
  const [error, setError] = useState('')
  const consultationAutomatiqueLancee = useRef(false)

  function fermerDetail() {
    setShowDetail(false)
    if (autoOpen) onAutoOpenClose?.()
  }

  async function consulter() {
    setLoading(true)
    setError('')

    try {
      const body = await api<FicheDetail>(
        `/api/v1/fiches/${ficheId}`,
        token,
      )

      setDetail(body)
      setShowDetail(true)
    } catch (e) {
      if (e instanceof ApiError && e.status === 401) {
        await onSessionInvalid()
        return
      }

      setError(
        e instanceof Error
          ? e.message
          : 'Impossible de consulter la fiche.',
      )
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    if (!autoOpen || consultationAutomatiqueLancee.current) return

    consultationAutomatiqueLancee.current = true
    void consulter()
  }, [autoOpen, ficheId, token])

  async function supprimer() {
    const confirme = window.confirm(
      `Supprimer la fiche ${numeroFiche || ficheId} ? Cette suppression sera enregistrée dans l’historique.`,
    )

    if (!confirme) return

    setDeleting(true)
    setError('')

    try {
      await api<void>(
        `/api/v1/fiches/${ficheId}`,
        token,
        { method: 'DELETE' },
      )

      await onRefresh()
      fermerDetail()
    } catch (e) {
      if (e instanceof ApiError && e.status === 401) {
        await onSessionInvalid()
        return
      }

      setError(
        e instanceof Error
          ? e.message
          : 'Impossible de supprimer la fiche.',
      )
    } finally {
      setDeleting(false)
    }
  }

  const validationConfirmee = Boolean(
    detail?.validation_confirmee ?? fiche?.validation_confirmee,
  )

  return (
    <>
      {!hideActions && (
        <div className="fiche-actions">
          <button
            type="button"
            className="secondary-button"
            disabled={loading || deleting}
            onClick={() => void consulter()}
          >
            {loading ? 'Chargement…' : 'Consulter'}
          </button>

          {role === 'administrateur_national' && (
            <button
              type="button"
              className="danger-button"
              disabled={loading || deleting}
              onClick={() => void supprimer()}
            >
              {deleting ? 'Suppression…' : 'Supprimer'}
            </button>
          )}
        </div>
      )}

      {error && <p className="alert error">{error}</p>}

      {showDetail && detail && createPortal(
        <div className="user-modal-backdrop" onClick={fermerDetail}>
          <section
            className="user-modal fiche-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="fiche-detail-title"
            onClick={(event) => event.stopPropagation()}
          >
            <div className="panel-heading fiche-modal-header">
              <div>
                <h2 id="fiche-detail-title">
                  Fiche {String(detail.numero_fiche || numeroFiche || ficheId)}
                </h2>
                <p className="muted">
                  Consultation des données enregistrées
                </p>
              </div>

              <button
                type="button"
                className="secondary-button"
                onClick={fermerDetail}
              >
                Fermer
              </button>
            </div>

            {error && <div className="alert error">{error}</div>}

            <div className="user-form-grid fiche-detail-content">
              {Object.entries(detail)
                .filter(
                  ([key]) =>
                    ![
                      'id',
                      'agent_id',
                      'validee_par_id',
                      'supprime_le',
                    ].includes(key),
                )
                .map(([key, value]) => (
                  <label className="nf-field" key={key}>
                    <span>{labels[key] || key.replaceAll('_', ' ')}</span>
                    <input readOnly value={displayValue(value)} />
                  </label>
                ))}
            </div>

            {showWorkflowActions && (
              <div className="fiche-modal-footer">
                <div className="fiche-modal-footer-info">
                  <strong>Gestion de la fiche</strong>
                  <span>
                    {validationConfirmee
                      ? 'Cette fiche est déjà validée.'
                      : 'Choisissez une action à effectuer sur cette fiche.'}
                  </span>
                </div>

                <div className="fiche-modal-footer-buttons">
                  {role === 'superviseur' && !validationConfirmee && (
                    <>
                      <button
                        type="button"
                        className="secondary-button"
                        disabled={busy || deleting}
                        onClick={() => fiche && onAction?.(fiche, 'valider')}
                      >
                        Valider
                      </button>

                      <button
                        type="button"
                        className="secondary-button"
                        disabled={busy || deleting}
                        onClick={() =>
                          fiche && onAction?.(fiche, 'demander-correction')
                        }
                      >
                        Demander correction
                      </button>

                      <button
                        type="button"
                        className="secondary-button"
                        disabled={busy || deleting}
                        onClick={() =>
                          fiche && onAction?.(fiche, 'traiter-correction')
                        }
                      >
                        Traiter réponse
                      </button>
                    </>
                  )}

                  {role === 'administrateur_national' && (
                    <button
                      type="button"
                      className="danger-button"
                      disabled={deleting || busy}
                      onClick={() => void supprimer()}
                    >
                      {deleting ? 'Suppression…' : 'Supprimer la fiche'}
                    </button>
                  )}

                  {role === 'superviseur' && validationConfirmee && (
                    <span className="status confirmed">
                      Déjà validée
                    </span>
                  )}
                </div>
              </div>
            )}
          </section>
        </div>, document.body)}
    </>
  )
}

