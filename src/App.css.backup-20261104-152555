:root {
  --navy: #102b4e;
  --blue: #1769aa;
  --blue-light: #eaf3fc;
  --text: #172b4d;
  --muted: #748198;
  --border: #e7ebf2;
  --surface: #fff;
}
.app-shell { display:flex; min-height:100vh; }
.sidebar { width:258px; background:var(--navy); color:#fff; display:flex; flex-direction:column; flex-shrink:0; padding:25px 15px 17px; }
.brand { display:flex; align-items:center; gap:12px; padding:0 12px 35px; }
.brand-mark { width:40px; height:40px; border-radius:12px; background:#2b83c9; color:#fff; display:grid; place-items:center; font-size:23px; font-weight:800; box-shadow:0 5px 14px #071e3a40; }
.brand strong { display:block; letter-spacing:.4px; font-size:16px; }
.brand strong span { color:#8fc9f5; }
.brand small { display:block; color:#aabbd0; font-size:11px; margin-top:3px; }
.nav-caption,.eyebrow { font-size:13px; font-weight:800; letter-spacing:1.25px; }
.nav-caption { color:#8ea4bf; padding:0 13px 12px; }
.sidebar nav { display:grid; gap:5px; }
.nav-item { position:relative; display:flex; align-items:center; gap:13px; width:100%; border:0; border-radius:8px; background:transparent; color:#c5d2e1; padding:13px 13px; text-align:left; font-size:13px; transition:.15s; }
.nav-item:hover { background:#ffffff0d; color:#fff; }
.nav-item.active { background:#1d4771; color:#fff; font-weight:650; }
.nav-icon { font-size:19px; width:22px; text-align:center; }
.nav-indicator { position:absolute; right:0; top:11px; bottom:11px; width:3px; border-radius:5px; background:#68b9f1; }
.sidebar-bottom { margin-top:auto; }
.secure-badge { color:#b5c7d9; font-size:11px; border-top:1px solid #ffffff17; padding:18px 12px; }
.secure-badge span { color:#65d5a4; margin-right:7px; }
.profile { display:flex; align-items:center; gap:10px; padding:14px 7px 0; border-top:1px solid #ffffff17; }
.avatar { width:34px; height:34px; display:grid; place-items:center; border-radius:50%; background:#d8e9f8; color:#164b78; font-size:12px; font-weight:800; flex-shrink:0; }
.profile-info { min-width:0; flex:1; }
.profile-info strong,.profile-info small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.profile-info strong { font-size:11px; }
.profile-info small { color:#9fb4ca; font-size:10px; margin-top:3px; }
.logout-icon { color:#c4d1df; background:transparent; border:0; font-size:20px; padding:5px; }
.main-panel { min-width:0; flex:1; }
.topbar { min-height:67px; padding:0 34px; display:flex; align-items:center; justify-content:space-between; gap:15px; background:#fff; border-bottom:1px solid var(--border); }
.breadcrumbs { color:#8793a6; font-size:12px; }
.breadcrumbs span { margin:0 10px; color:#c1cad5; }
.breadcrumbs strong { color:#344968; font-weight:650; }
.top-actions { display:flex; align-items:center; gap:20px; }
.connection { display:flex; align-items:center; gap:7px; font-size:11px; color:#53647b; }
.online-dot { width:7px; height:7px; border-radius:50%; background:#24b47e; box-shadow:0 0 0 3px #24b47e1b; }
.refresh-button { border:1px solid #dce4ee; background:#fff; border-radius:7px; padding:8px 12px; color:#425671; font-size:11px; }
.refresh-button span { font-size:16px; margin-right:5px; }
.content { max-width:1600px; margin:auto; padding:30px 34px 18px; }
.page-heading { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:25px; }
.eyebrow { color:#2580be; }
.page-heading h1 { margin:8px 0 6px; font-size:26px; line-height:1.25; font-weight:750; letter-spacing:-.65px; color:#173253; }
.muted { color:var(--muted); font-size:17px; line-height:1.6; }
.date-chip { padding:9px 13px; border:1px solid #e2e8f0; background:#fff; border-radius:7px; color:#64758c; font-size:11px; white-space:nowrap; }
.stats-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin-bottom:22px; }
.stat-card,.panel { background:var(--surface); border:1px solid var(--border); border-radius:10px; box-shadow:0 2px 7px #1a355008; }
.stat-card { padding:19px 19px 17px; min-width:0; }
.stat-top { display:flex; align-items:center; justify-content:space-between; gap:10px; color:#6d7b91; font-size:11px; font-weight:600; }
.stat-icon { width:35px; height:35px; display:grid; place-items:center; border-radius:9px; font-size:19px; }
.stat-icon.blue,.quick-icon.blue { color:#2678bd; background:#e9f3fd; }
.stat-icon.violet,.quick-icon.violet { color:#8161c7; background:#f0ecfc; }
.stat-icon.green,.quick-icon.green { color:#239a73; background:#e5f7ef; }
.stat-icon.amber { color:#bc8628; background:#fff4de; }
.stat-value { display:block; margin-top:15px; font-size:30px; line-height:1.1; font-weight:750; color:#193757; letter-spacing:-.8px; }
.stat-detail { display:block; margin-top:8px; font-size:10px; color:#98a3b4; }
.panel { padding:21px; min-width:0; }
.panel-heading { display:flex; align-items:center; justify-content:space-between; gap:15px; margin-bottom:17px; }
.panel-heading h2 { margin:0 0 5px; font-size:15px; color:#1d3859; font-weight:750; }
.panel-heading p { margin:0; }
.text-button { border:0; background:transparent; color:#2479b8; font-size:11px; font-weight:700; white-space:nowrap; }
.text-button span { margin-left:5px; }
.table-wrap { width:100%; overflow:auto; }
table { width:100%; border-collapse:collapse; text-align:left; white-space:nowrap; }
th { padding:12px 13px; color:#8592a5; font-size:10px; font-weight:750; background:#f8fafd; border-top:1px solid #edf0f5; border-bottom:1px solid #edf0f5; }
td { padding:14px 13px; color:#52627a; font-size:11px; border-bottom:1px solid #eff2f6; }
tbody tr:last-child td { border-bottom:0; }
tbody tr:hover { background:#fbfdff; }
td strong { color:#2a405d; font-weight:700; }
.status,.role-pill,.diagnostic { display:inline-flex; align-items:center; border-radius:20px; padding:5px 9px; font-size:10px; font-weight:650; }
.status.confirmed { background:#e7f8ef; color:#21865c; }
.status.pending { background:#fff4df; color:#a7751e; }
.status.inactive { background:#fceaea; color:#b74444; }
.role-pill { background:#edf3fa; color:#536e8d; text-transform:capitalize; }
.diagnostic { background:#edf4fc; color:#3e6e9e; }
.cell-sub { display:block; margin-top:4px; font-size:10px; color:#9aa5b4; }
.table-foot { margin:14px 0 0; color:#8b98aa; font-size:10px; }
.bottom-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-top:19px; }
.structure-list { display:grid; }
.structure-row { display:flex; align-items:center; gap:11px; padding:12px 0; border-bottom:1px solid #eff2f6; color:#52637a; font-size:11px; }
.structure-row:last-child { border-bottom:0; }
.structure-row-icon { width:31px; height:31px; display:grid; place-items:center; border-radius:8px; color:#3983b9; background:#eef6fc; font-size:16px; flex-shrink:0; }
.structure-row > span:nth-child(2) { flex:1; }
.structure-row > strong { color:#203d5d; font-size:13px; }
.quick-link { width:100%; display:flex; align-items:center; gap:11px; padding:12px 0; border:0; border-bottom:1px solid #eff2f6; background:transparent; text-align:left; }
.quick-link:last-child { border-bottom:0; }
.quick-icon { width:33px; height:33px; border-radius:8px; display:grid; place-items:center; font-size:17px; flex-shrink:0; }
.quick-link > span:nth-child(2) { flex:1; }
.quick-link strong,.quick-link small { display:block; }
.quick-link strong { font-size:11px; color:#304764; }
.quick-link small { font-size:10px; color:#8b98aa; margin-top:4px; }
.quick-link > b { color:#8191a6; font-size:17px; }
.search-input { width:min(250px,45%); border:1px solid #dfe6ef; border-radius:7px; padding:10px 12px; outline:none; color:#263d5a; font-size:11px; }
.search-input:focus,input:focus { border-color:#6aa8d6; box-shadow:0 0 0 3px #368aca15; outline:none; }
.empty-state { min-height:110px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:9px; color:#95a2b4; text-align:center; font-size:12px; }
.empty-state span { font-size:24px; color:#b5c4d5; }
.empty-state p { margin:0; }
.structure-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
.structure-panel .panel-heading { margin-bottom:8px; }
.alert { padding:12px 14px; border-radius:7px; font-size:12px; line-height:1.5; margin:12px 0; }
.alert.error { color:#a13232; background:#fff0f0; border:1px solid #f3d2d2; }
.footer { display:flex; justify-content:space-between; gap:15px; color:#9aa5b4; font-size:10px; padding:26px 1px 5px; }
.footer span:first-child { font-weight:800; letter-spacing:.4px; color:#6e8199; }
.spin { display:inline-block; animation:spin .8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

/* Connexion */
.login-layout { min-height:100vh; display:grid; grid-template-columns:1fr 1fr; background:#fff; }
.login-brand { background:linear-gradient(145deg,#102b4e 0%,#154b78 68%,#1e6694 100%); padding:clamp(35px,7vw,100px); color:#fff; display:flex; flex-direction:column; justify-content:center; position:relative; overflow:hidden; }
.login-brand::after { content:""; width:460px; height:460px; position:absolute; right:-200px; bottom:-210px; border:1px solid #ffffff19; border-radius:50%; box-shadow:0 0 0 55px #ffffff08,0 0 0 110px #ffffff06; }
.login-brand .eyebrow { color:#91c9f2; line-height:1.8; }
.login-brand h1 { font-size:clamp(34px,4vw,54px); letter-spacing:-1.5px; margin:22px 0 12px; }
.login-brand h1 span { color:#79bced; }
.login-brand > p { max-width:380px; color:#c1d4e7; font-size:14px; line-height:1.8; }
.login-note { margin-top:55px; display:flex; align-items:center; gap:13px; }
.note-icon { width:36px; height:36px; display:grid; place-items:center; border:1px solid #ffffff45; border-radius:10px; color:#8ee2b7; }
.login-note strong,.login-note small { display:block; }
.login-note strong { font-size:12px; }
.login-note small { margin-top:5px; color:#b4c8dc; font-size:11px; }
.login-panel { display:grid; place-items:center; padding:35px; }
.login-card { width:100%; max-width:380px; }
.login-card .eyebrow { color:#3285bd; }
.login-card h2 { margin:12px 0 6px; color:#193756; font-size:30px; letter-spacing:-.7px; }
.login-card .muted { margin-bottom:28px; }
.login-card label { display:block; margin:18px 0 8px; font-size:11px; font-weight:700; color:#40546e; }
.login-card input { width:100%; border:1px solid #dce4ed; border-radius:7px; padding:13px 12px; color:#233d5b; font-size:12px; background:#fff; }
.primary-button { border:0; background:#1769aa; color:#fff; border-radius:7px; padding:13px 15px; font-size:12px; font-weight:700; box-shadow:0 4px 9px #1769aa26; }
.primary-button:hover { background:#12578e; }
.login-button { width:100%; margin-top:23px; display:flex; align-items:center; justify-content:space-between; }
.login-button span { font-size:17px; }
.login-foot { text-align:center; color:#99a4b3; font-size:10px; margin-top:20px; }
.mobile-brand { display:none; }
@media(max-width:1100px) {
  .content { padding:25px 22px 16px; }
  .stats-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media(max-width:760px) {
  .content { padding:22px 14px 14px; }
  .page-heading { align-items:flex-start; margin-bottom:18px; }
  .page-heading h1 { font-size:23px; }
  .date-chip { font-size:10px; padding:7px; }
  .stats-grid { gap:10px; }
  .stat-card { padding:14px; }
  .stat-top { align-items:flex-start; font-size:10px; }
  .stat-icon { width:30px; height:30px; flex-shrink:0; }
  .stat-value { font-size:26px; }
  .stat-detail { font-size:9px; line-height:1.5; }
  .bottom-grid,.structure-grid { grid-template-columns:1fr; }
  .panel { padding:15px; }
  .panel-heading { align-items:flex-start; flex-wrap:wrap; }
  .search-input { width:100%; max-width:none; }
  .footer { flex-direction:column; gap:5px; }
  .login-layout { grid-template-columns:1fr; }
  .login-brand { display:none; }
  .login-panel { min-height:100vh; padding:25px; }
  .mobile-brand { display:flex; align-items:center; gap:10px; font-weight:800; color:#173b60; margin-bottom:45px; }
}

/* Formulaire de nouvelle fiche paludisme */
.nf-toolbar { display:flex; justify-content:flex-end; margin:0 0 16px; }
.nf-panel { margin-bottom:20px; }
.nf-context { display:flex; flex-wrap:wrap; gap:8px 18px; padding:12px 14px; margin-bottom:18px; border:1px solid #dceaf5; border-radius:8px; background:#f4f9fd; color:#52627a; font-size:12px; }
.nf-context strong { color:#193757; }
.nf-section { border:1px solid #e3eaf2; border-radius:9px; padding:16px; margin:0 0 16px; min-width:0; }
.nf-section legend { padding:0 7px; color:#1d527e; font-weight:750; font-size:13px; }
.nf-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
.nf-field { display:flex; flex-direction:column; gap:6px; min-width:0; color:#52627a; font-size:12px; font-weight:600; }
.nf-field input,.nf-field select,.nf-field textarea { width:100%; box-sizing:border-box; border:1px solid #dfe6ef; border-radius:7px; padding:10px 11px; background:#fff; color:#263d5a; font:inherit; font-weight:400; }
.nf-field textarea { resize:vertical; }
.nf-wide { grid-column:1/-1; }
.nf-actions { display:flex; justify-content:flex-end; gap:10px; flex-wrap:wrap; }
.secondary-button { border:1px solid #d9e2ec; background:#fff; color:#38536e; border-radius:7px; padding:11px 14px; font-size:12px; font-weight:700; }
.secondary-button:disabled,.primary-button:disabled { opacity:.55; cursor:not-allowed; }
@media(max-width:600px) {
  .nf-grid { grid-template-columns:1fr; }
  .nf-wide { grid-column:auto; }
  .nf-section { padding:12px; }
}
.nf-header-actions { display:flex; align-items:center; gap:12px; }
.nf-plus-button {
  display:inline-flex; align-items:center; justify-content:center;
  width:42px; height:42px; flex:0 0 42px;
  border:0; border-radius:50%; background:#1769aa; color:#fff;
  font-size:29px; line-height:1; font-weight:400;
  box-shadow:0 4px 10px #1769aa30; cursor:pointer;
}
.nf-plus-button:hover:not(:disabled) { background:#12578e; transform:translateY(-1px); }
.nf-plus-button:disabled { opacity:.45; cursor:not-allowed; }
@media(max-width:760px) {
  .nf-header-actions { width:100%; }
  .nf-header-actions .search-input { flex:1; width:auto; max-width:none; }
}


/* Gestion CRUD des utilisateurs */
.user-crud-heading {
  align-items: center;
}

.user-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 18px;
}

.user-filters .search-input {
  width: min(420px, 100%);
  max-width: 100%;
  box-sizing: border-box;
}

.user-filters select,
.user-modal select,
.user-modal input {
  min-width: 0;
  box-sizing: border-box;
}

.user-filters select {
  border: 1px solid #dfe6ef;
  border-radius: 7px;
  padding: 10px 12px;
  background: #fff;
  color: #263d5a;
  font-size: 12px;
}

.user-row-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.user-row-actions .secondary-button,
.user-row-actions .danger-button {
  padding: 7px 9px;
  font-size: 10px;
}

.danger-button {
  border: 1px solid #f0cccc;
  border-radius: 7px;
  background: #fff5f5;
  color: #b33434;
  padding: 9px 12px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.danger-button:hover:not(:disabled) {
  background: #ffe9e9;
}

.danger-button:disabled {
  opacity: .55;
  cursor: not-allowed;
}

.user-notice {
  color: #176c4b;
  background: #eaf8f0;
  border: 1px solid #c9ead8;
}

.user-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  overflow-y: auto;
  padding: 35px 16px;
  background: #0c203b88;
}

.user-modal {
  width: min(800px, 100%);
  box-sizing: border-box;
  padding: 24px;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 20px 60px #071e3a40;
}

.user-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin: 18px 0;
}

.user-form-wide {
  grid-column: 1 / -1;
}

.user-modal .nf-field input,
.user-modal .nf-field select {
  width: 100%;
  min-height: 40px;
}

.user-modal .nf-field input:disabled,
.user-modal .nf-field select:disabled {
  background: #f5f7fa;
  color: #62738a;
}

.user-modal .nf-actions {
  margin-top: 20px;
}

@media (max-width: 760px) {
  .user-crud-heading {
    align-items: flex-start;
  }

  .user-form-grid {
    grid-template-columns: 1fr;
  }

  .user-form-wide {
    grid-column: auto;
  }

  .user-modal {
    padding: 16px;
  }

  .user-modal-backdrop {
    padding: 12px;
  }
}


/* Boîte de réception */
.mailbox-heading {
  margin-bottom: 20px;
}

.mailbox-toolbar,
.mailbox-filters,
.mailbox-item-top,
.mailbox-meta {
  display: flex;
  align-items: center;
  gap: 12px;
}

.mailbox-toolbar {
  justify-content: space-between;
  flex-wrap: wrap;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}

.mailbox-filters {
  gap: 6px;
}

.mailbox-filter {
  border: 1px solid transparent;
  border-radius: 7px;
  background: transparent;
  color: #64758c;
  padding: 9px 12px;
  font-size: 12px;
  cursor: pointer;
}

.mailbox-filter.active {
  background: #eaf3fb;
  color: #1769aa;
  border-color: #d7e9f8;
  font-weight: 700;
}

.mailbox-list {
  display: flex;
  flex-direction: column;
}

.mailbox-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 18px 4px;
  border-bottom: 1px solid #edf0f5;
}

.mailbox-item.unread {
  background: #f7fbff;
}

.mailbox-item-icon {
  display: grid;
  place-items: center;
  flex: 0 0 34px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #eaf3fb;
  color: #1769aa;
  font-size: 13px;
}

.mailbox-item.read .mailbox-item-icon {
  background: #edf7f1;
  color: #33865b;
}

.mailbox-item-content {
  flex: 1;
  min-width: 0;
}

.mailbox-item-top {
  justify-content: space-between;
  flex-wrap: wrap;
}

.mailbox-item-top strong {
  color: #1d3859;
  font-size: 13px;
}

.mailbox-item-content > p {
  margin: 8px 0;
  color: #53657c;
  font-size: 12px;
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.mailbox-unread-label {
  padding: 4px 8px;
  border-radius: 20px;
  background: #eaf3fb;
  color: #1769aa;
  font-size: 10px;
  font-weight: 700;
}

.mailbox-meta {
  flex-wrap: wrap;
  color: #8793a4;
  font-size: 10px;
}

.mailbox-read-button {
  flex-shrink: 0;
}

.mailbox-empty {
  padding: 42px 15px;
  text-align: center;
  color: #718096;
  font-size: 12px;
}

.mailbox-empty strong {
  display: block;
  margin-top: 10px;
  color: #1d3859;
  font-size: 14px;
}

.mailbox-empty p {
  line-height: 1.6;
}

.mailbox-empty-icon {
  font-size: 30px;
}

@media (max-width: 700px) {
  .mailbox-item {
    flex-wrap: wrap;
  }

  .mailbox-read-button {
    margin-left: 48px;
  }
}

.notification-badge {
  margin-left: auto;
  min-width: 21px;
  height: 21px;
  padding: 0 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #d94b4b;
  color: #fff;
  font-size: 10px;
  font-weight: 750;
}


/* ===== Refonte visuelle SCDIP-PNLP (conforme à la maquette) ===== */
:root{--navy:#0b2a55;--blue:#0a5fd8;--green:#0a9a45;--text:#102b4e;--muted:#6b7b93;--border:#dde6f2;--surface:#fff}
html,body{margin:0}
body{background:#f5f7fc;color:var(--text);font-family:Inter,"Segoe UI",ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,Roboto,sans-serif;-webkit-font-smoothing:antialiased}
button{cursor:pointer;font:inherit}
svg{display:block;flex-shrink:0}
.app-shell{display:flex;min-height:100vh;background:#f5f7fc;position:relative}
.main-panel{min-width:0;flex:1;background:#f5f7fc;padding-top:7px}
.app-shell:before{content:"";position:fixed;top:0;left:0;right:0;height:7px;z-index:80;pointer-events:none;background:linear-gradient(90deg,#0a2d63,#0a5a9a 45%,#0a8a6a 80%,#17a24a)}

/* Menu latéral */
.sidebar{width:288px;flex:0 0 288px;position:sticky;top:0;height:100vh;box-sizing:border-box;display:flex;flex-direction:column;padding:41px 12px 0;color:#12305a;overflow:hidden;
  background:
   radial-gradient(120% 34% at 8% 6%,#8fb9dd 0%,transparent 70%),
   radial-gradient(90% 26% at 10% 27%,#6d9cdc 0%,transparent 72%),
   linear-gradient(180deg,#a6c4e1 0%,#84a9d7 24%,#8590ac 42%,#a7aec2 60%,#d4dce4 76%,#e7f0ee 100%);
  border-right:1px solid #d4deea;border-radius:0}
.sidebar:before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,transparent 55%,#ffffff55 100%)}
.sidebar>*{position:relative}
.sidebar-brand{display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 0 26px}
.sidebar-emblem{width:172px;height:auto;filter:drop-shadow(0 8px 14px #0b2a5530)}
.sidebar-wordmark{display:flex;align-items:center;gap:5px;margin-top:8px}
.sidebar-wordmark img{width:58px;height:auto}
.sidebar-wordmark strong{font-size:31px;line-height:1;font-weight:800;letter-spacing:-.5px;color:#0b2a63}
.sidebar-wordmark strong span{color:#12973f}
.sidebar-brand small{margin-top:4px;color:#0b2a55;font-size:14.5px}
.sidebar nav{display:grid;gap:2px;margin-top:6px}
.nav-item{position:relative;display:flex;align-items:center;gap:18px;width:100%;box-sizing:border-box;min-height:60px;border:0;border-radius:12px;background:transparent;color:#14305a;padding:0 18px 0 16px;text-align:left;font-size:17.5px;font-weight:500;transition:background .15s,color .15s}
.nav-item .nav-icon{width:34px;height:34px;display:grid;place-items:center;font-size:inherit}
.nav-item .nav-icon svg{width:30px;height:30px}
.nav-item:hover{background:#ffffff40}
.nav-item.active{background:linear-gradient(180deg,#0a63d8,#0556c8);color:#fff;box-shadow:0 8px 18px #0a5fd838}
.nav-item.active:hover{background:linear-gradient(180deg,#0a63d8,#0556c8)}
.nav-label{flex:1}
.notification-badge{margin:0;min-width:27px;height:27px;padding:0 7px;box-sizing:border-box;border-radius:14px;background:radial-gradient(circle at 35% 30%,#ff5a5a,#e5101a);color:#fff;font-size:14px;font-weight:700;box-shadow:0 3px 10px #e5101a55}
.nav-separator{height:1px;margin:16px 14px 14px;background:#ffffffa0;box-shadow:0 1px 0 #1b3f7620}
.nav-logout{margin-top:0}
.sidebar-bottom{margin-top:auto;margin-left:-12px;margin-right:-12px;padding-bottom:34px}
.sidebar-slogan{margin:0 0 14px;padding:0 12px;text-align:center;color:#0a4aa8;font-size:19.5px;line-height:1.3;font-weight:600;font-style:italic;letter-spacing:-.2px}
.sidebar-flag{display:block;width:calc(100% - 8px);height:auto;margin-left:4px}
.sidebar-backdrop{display:none}

/* Barre supérieure */
.topbar{height:108px;min-height:0;box-sizing:border-box;padding:0 32px 0 30px;display:flex;align-items:center;gap:26px;background:#fbfcfe;border-bottom:1px solid #e1e8f1;box-shadow:0 1px 0 #fff inset}
.menu-toggle{width:44px;height:44px;border:0;background:transparent;color:#0b2455;display:grid;place-items:center;border-radius:10px;padding:0}
.menu-toggle svg{width:38px;height:38px}
.menu-toggle:hover{background:#eaf1fa}
.topbar-title{min-width:0;flex:1}
.topbar-title h1{margin:0;font-size:37px;line-height:1.05;font-weight:800;letter-spacing:-.6px;color:#0b2455}
.topbar-title p{margin:6px 0 0;font-size:18.5px;color:#27395a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.top-actions{display:flex;align-items:center;gap:18px}
.icon-button{width:42px;height:42px;border:0;border-radius:50%;background:transparent;color:#35507a;display:grid;place-items:center;padding:0}
.icon-button svg{width:24px;height:24px}
.icon-button:hover:not(:disabled){background:#eaf1fa}
.icon-button:disabled{opacity:.6;cursor:default}
.bell-button{position:relative;width:48px;height:48px;border:0;background:transparent;color:#0b2455;padding:0;display:grid;place-items:center;border-radius:50%}
.bell-button svg{width:38px;height:38px}
.bell-button:hover:not(:disabled){background:#eaf1fa}
.bell-button.is-off{color:#6d7f9c}
.bell-button:disabled{opacity:.6}
.bell-badge{position:absolute;top:0;right:-4px;min-width:23px;height:23px;padding:0 5px;box-sizing:border-box;border-radius:12px;background:radial-gradient(circle at 35% 30%,#ff5a5a,#e5101a);color:#fff;font-size:13px;font-weight:700;display:grid;place-items:center;box-shadow:0 2px 6px #e5101a55}
.top-divider{width:1px;height:62px;background:#d8e0ea;margin:0 4px}
.user-pill{display:flex;align-items:center;gap:14px;color:#16305a}
.user-avatar{width:60px;height:60px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 50% 35%,#f4f8ff,#cfe0fb);color:#0a47d6;box-shadow:0 0 0 3px #e9f0fd,0 4px 12px #0a47d625;overflow:hidden}
.user-avatar svg{width:42px;height:42px;margin-top:8px}
.user-meta{display:flex;flex-direction:column;gap:3px;min-width:0}
.user-meta strong{font-size:16px;line-height:1.1;font-weight:700;color:#0b2455;white-space:nowrap}
.user-meta small{font-size:16px;line-height:1.1;color:#0a5fe0;font-weight:500;text-transform:capitalize}

/* Contenu */
.content{max-width:none;margin:0;padding:19px 20px 18px 19px}
.page-heading{margin-bottom:22px}
.page-heading h1{font-size:29px;color:#102f52}
.page-heading .eyebrow{color:#0a8b55}
.date-chip{border-radius:10px;background:#fff}
.dashboard-hero{position:relative;isolation:isolate;display:flex;align-items:center;min-height:238px;overflow:hidden;margin:0 0 22px;padding:0 36px;border-radius:12px;color:#fff;background:linear-gradient(90deg,#012651 0%,#01315a 30%,#03474f 62%,#0a5d46 100%);box-shadow:0 10px 26px #0b47751f}
.hero-art{position:absolute;z-index:-1;right:0;top:0;height:100%;width:auto;max-width:none;object-fit:cover;object-position:left center;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 34%);mask-image:linear-gradient(90deg,transparent 0,#000 34%)}
.hero-copy{position:relative;max-width:660px;padding-top:10px}
.hero-copy h2{margin:0 0 18px;font-size:41px;line-height:1.1;font-weight:800;letter-spacing:-.8px}
.hero-copy h2 span{color:#2fd465}
.hero-copy p{margin:0;font-size:27px;line-height:1.2;font-weight:500;color:#f2f7fd;letter-spacing:-.3px}
.hero-button{display:inline-flex;align-items:center;gap:14px;margin-top:30px;padding:0 28px 0 26px;height:46px;border:0;border-radius:24px;background:linear-gradient(180deg,#14ae4c,#0b9a3c);color:#fff;font-size:17px;font-weight:600;box-shadow:0 6px 16px #05381f55}
.hero-button svg{width:22px;height:22px}
.hero-button:hover{filter:brightness(1.07)}
.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-bottom:20px}
.kpi-card{position:relative;overflow:hidden;box-sizing:border-box;min-height:149px;display:flex;align-items:flex-start;gap:20px;padding:16px 18px;border:1px solid;border-radius:14px;text-align:left;font:inherit;color:inherit;box-shadow:0 4px 14px #14335b0b}
button.kpi-card{width:100%}
.kpi-card.is-clickable:hover{transform:translateY(-1px);box-shadow:0 8px 20px #14335b14}
.kpi-blue{border-color:#a9cdf5;background:linear-gradient(135deg,#f7fbff,#e5f1fd)}
.kpi-green{border-color:#a8e3c0;background:linear-gradient(135deg,#f6fdf9,#e3f6ec)}
.kpi-orange{border-color:#f7cd9b;background:linear-gradient(135deg,#fffaf4,#fff0e0)}
.kpi-violet{border-color:#cfc4f6;background:linear-gradient(135deg,#faf9ff,#eeeafd)}
.kpi-icon{width:84px;height:84px;flex:0 0 84px;display:grid;place-items:center;border-radius:20px;color:#fff;box-shadow:0 8px 16px #0b2a5526}
.kpi-icon svg{width:50px;height:50px}
.kpi-blue .kpi-icon{background:linear-gradient(145deg,#1f7cf6,#0553d6)}
.kpi-green .kpi-icon{background:linear-gradient(145deg,#1ca64e,#0b8a35)}
.kpi-orange .kpi-icon{background:linear-gradient(145deg,#ffa21f,#f67c00)}
.kpi-violet .kpi-icon{background:linear-gradient(145deg,#4a2fd0,#2a14a3)}
.kpi-body{display:flex;flex-direction:column;min-width:0;padding-top:2px}
.kpi-value{font-size:40px;line-height:1.05;font-weight:700;letter-spacing:-.8px;color:#0f2a4e;font-variant-numeric:tabular-nums}
.kpi-label{margin-top:6px;font-size:18px;line-height:1.2;color:#1f3558}
.kpi-trend{position:absolute;left:122px;bottom:14px;font-size:14.5px;font-weight:600;color:#12853e}
.kpi-trend.down{color:#c23a3a}
.kpi-spark{position:absolute;right:0;bottom:0;width:36%;height:44px}
.kpi-spark-area{fill:#2f80ed;opacity:.14}
.kpi-spark-line{fill:none;stroke:#2f80ed;stroke-width:2;vector-effect:non-scaling-stroke}
.kpi-green .kpi-spark-area{fill:#1c9e4d}
.kpi-green .kpi-spark-line{stroke:#1c9e4d}
.kpi-arrow{position:absolute;right:18px;bottom:14px;color:#2b3f66}
.kpi-arrow svg{width:26px;height:26px;transform:rotate(-90deg)}
.kpi-orange .kpi-arrow{color:#8a4a0d}
.kpi-violet .kpi-arrow{color:#3a2a9a}

.dashboard-insights{display:grid;grid-template-columns:minmax(0,1.31fr) minmax(0,1fr);gap:15px;margin-bottom:26px}
.panel{background:#fff;border:1px solid var(--border);border-radius:14px;box-shadow:0 4px 16px #173c5b08;padding:21px}
.evolution-panel,.notification-panel{padding:22px 22px 14px}
.panel-title-row{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:6px}
.panel-title-row h2{display:flex;align-items:center;gap:12px;margin:0;font-size:21px;font-weight:800;color:#0e2650;letter-spacing:-.3px}
.panel-title-row h2 svg{width:26px;height:26px;color:#0a3d8f}
.chart-legend{display:flex;flex-wrap:wrap;gap:22px;color:#1f3558;font-size:16px}
.chart-legend span{display:inline-flex;align-items:center;gap:9px}
.chart-legend i{width:13px;height:13px;display:inline-block;border-radius:50%}
.legend-blue{background:#0b57e0}.legend-green{background:#0f9d46}
.chart-wrap{width:100%}
.evolution-chart{width:100%;height:auto;overflow:visible}
.chart-gridline{stroke:#dfe6f0;stroke-width:1}
.chart-line{fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.chart-line-blue{stroke:#0b57e0}.chart-line-green{stroke:#0f9d46}
.chart-dot-blue{fill:#0b57e0;stroke:#fff;stroke-width:1.5}.chart-dot-green{fill:#0f9d46;stroke:#fff;stroke-width:1.5}
.chart-label{fill:#1d3358;font-size:16px}
.text-button{display:inline-flex;align-items:center;gap:8px;border:0;background:transparent;color:#0a52d8;font-size:16px;font-weight:600;white-space:nowrap}
.text-button svg{width:20px;height:20px}
.notif-list{display:flex;flex-direction:column}
.notif-row{display:flex;align-items:center;gap:16px;min-height:70px;box-sizing:border-box;padding:8px 0;border-top:1px solid #e5ebf3}
.notif-row:first-child{margin-top:10px}
.notif-icon{width:46px;height:46px;flex:0 0 46px;display:grid;place-items:center;border-radius:50%;color:#fff}
.notif-icon svg{width:26px;height:26px}
.notif-green{background:#12a84a}.notif-blue{background:#0a5fe0}.notif-orange{background:#ff9d12}
.notif-text{display:flex;flex-direction:column;min-width:0;flex:1}
.notif-text strong{font-size:18px;font-weight:500;color:#0e2650;line-height:1.25}
.notif-text small{margin-top:3px;font-size:15px;color:#5b6d88}
.notif-pill{padding:7px 17px;border-radius:20px;background:#cdeedb;color:#12703a;font-size:15.5px;font-weight:500;white-space:nowrap}
.notif-pill.pill-warn{background:#ffe7c2;color:#9a5a05}
.notif-pill.pill-off{background:#e6ebf2;color:#5b6d88}
.notif-date{font-size:15px;color:#27395a;white-space:nowrap}

.prevention-banner{position:relative;isolation:isolate;display:flex;align-items:center;gap:26px;height:119px;overflow:hidden;margin:0 0 24px;padding:0 0 0 30px;border:1px solid #b6dcea;border-radius:12px;background:linear-gradient(90deg,#d9f0eb 0%,#d3efee 50%,#c8e7f8 100%);box-shadow:0 4px 16px #173c5b0d}
.prevention-banner:before{content:"";position:absolute;z-index:-1;left:-4%;bottom:-48px;width:55%;height:92px;border-radius:50%;background:linear-gradient(90deg,#5fc46e,#9fdba9);opacity:.85}
.prevention-icon{flex:0 0 auto;filter:drop-shadow(0 4px 8px #0a7a3a40)}
.prevention-banner>strong{font-size:24px;font-weight:700;font-style:italic;color:#0a2870;letter-spacing:-.4px;line-height:1.2;position:relative;z-index:1}
.prevention-art{position:absolute;z-index:-1;right:0;top:0;height:100%;width:auto;max-width:none;object-fit:cover;object-position:left center;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 18%);mask-image:linear-gradient(90deg,transparent 0,#000 18%)}

.recent-panel{margin-top:0}
.table-wrap{border-radius:9px}
th{background:#f4f8fc}
.primary-button{border-radius:9px;background:linear-gradient(100deg,#0872d0,#075db3)}
.secondary-button{border-radius:8px}
.search-input{border-radius:9px}
.footer{color:#9aa8b8}

/* Connexion (inchangé fonctionnellement) */
.brand-mark{width:48px;height:48px;border-radius:15px;display:grid;place-items:center;overflow:hidden;color:#fff;background:#fff;box-shadow:0 8px 18px #0876cf30}
.brand-mark img{display:block;width:100%;height:100%;object-fit:contain;border-radius:inherit}
.login-layout{background:#f6f9fd}
.login-brand{background:linear-gradient(145deg,#082f55 0%,#07577b 70%,#07884c 120%)}
.login-card{padding:34px;border:1px solid #e3ebf4;border-radius:18px;background:#fff;box-shadow:0 18px 55px #0e345b12}
.mobile-brand .brand-mark{flex:0 0 44px}

/* Adaptation aux écrans plus petits */
@media(max-width:1500px){
  .hero-art,.prevention-art{max-width:70%}
  .sidebar{width:260px;flex-basis:260px}.nav-item{min-height:54px;font-size:16.5px}.sidebar-emblem{width:150px}.sidebar-wordmark strong{font-size:28px}.sidebar-wordmark img{width:56px}
  .topbar{height:92px}.topbar-title h1{font-size:31px}.topbar-title p{font-size:16px}.user-avatar{width:52px;height:52px}.user-avatar svg{width:36px;height:36px}
  .hero-copy h2{font-size:36px}.hero-copy p{font-size:23px}
  .kpi-card{gap:16px;min-height:136px}.kpi-icon{width:70px;height:70px;flex-basis:70px;border-radius:17px}.kpi-icon svg{width:42px;height:42px}.kpi-value{font-size:34px}.kpi-label{font-size:16px}.kpi-trend{left:106px;font-size:13.5px}
  .panel-title-row h2{font-size:19px}.notif-text strong{font-size:16.5px}.prevention-banner>strong{font-size:22px}
}
@media(max-width:1200px){
  .kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .dashboard-insights{grid-template-columns:1fr}
}
@media(max-width:900px){
  .app-shell{display:block}
  .sidebar{position:fixed;z-index:60;left:0;top:0;bottom:0;width:272px;height:100%;transform:translateX(-102%);transition:transform .22s ease;box-shadow:12px 0 40px #0b2a5540}
  .app-shell:not(.menu-closed) .sidebar{transform:none}
  .app-shell:not(.menu-closed) .sidebar-backdrop{display:block;position:fixed;inset:0;z-index:55;background:#0b1f3f66}
  .topbar{height:76px;padding:0 14px;gap:12px}
  .menu-toggle svg{width:32px;height:32px}
  .topbar-title h1{font-size:23px}.topbar-title p{display:none}
  .top-actions{gap:8px}.top-divider{display:none}.user-meta,.user-pill>svg{display:none}.user-avatar{width:42px;height:42px}.user-avatar svg{width:30px;height:30px}
  .bell-button svg{width:30px;height:30px}
  .content{padding:14px 12px 12px}
  .dashboard-hero{min-height:210px;padding:0 20px}.hero-art{max-width:100%;opacity:.55}.hero-copy h2{font-size:28px}.hero-copy p{font-size:18px}.hero-button{height:42px;font-size:15px;margin-top:18px}
  .kpi-grid{gap:12px}
  .page-heading{align-items:flex-start;margin-bottom:18px}.page-heading h1{font-size:23px}.date-chip{font-size:10px;padding:7px}
  .prevention-banner{height:auto;min-height:96px;padding:12px 14px;gap:14px}.prevention-banner>strong{font-size:16px}.prevention-art{opacity:.35;max-width:100%}.prevention-icon svg{width:36px;height:42px}
  .bottom-grid,.structure-grid{grid-template-columns:1fr}
  .login-card{padding:24px 19px;border:0;box-shadow:none}
}
@media(max-width:560px){
  .kpi-grid{grid-template-columns:1fr}
  .notif-row{flex-wrap:wrap}.notif-date{width:100%;padding-left:62px}
  .chart-legend{gap:12px;font-size:13px}.chart-label{font-size:14px}
}
@media(min-width:901px){.app-shell.menu-closed .sidebar{display:none}}

/* Échelle adaptée à la hauteur de l'écran : le drapeau du menu reste toujours visible */
@media(min-width:901px){
  .sidebar{padding-top:calc(7px + clamp(10px,3vh,34px));padding-bottom:0}
  .sidebar-emblem{width:clamp(96px,17vh,172px)}
  .sidebar-wordmark{margin-top:clamp(2px,.8vh,8px)}
  .sidebar-wordmark img{width:clamp(34px,5.6vh,58px)}
  .sidebar-wordmark strong{font-size:clamp(20px,3.1vh,31px)}
  .sidebar-brand small{font-size:clamp(11px,1.5vh,14.5px)}
  .sidebar-brand{padding-bottom:clamp(8px,2.4vh,26px)}
  .nav-item{min-height:clamp(38px,6vh,60px);font-size:clamp(14px,1.75vh,17.5px);gap:clamp(10px,1.8vh,18px)}
  .nav-item .nav-icon svg{width:clamp(20px,3vh,30px);height:clamp(20px,3vh,30px)}
  .nav-separator{margin:clamp(6px,1.6vh,16px) 14px clamp(6px,1.4vh,14px)}
  .sidebar-slogan{font-size:clamp(13px,1.9vh,19.5px);margin-bottom:clamp(4px,1.4vh,14px)}
  .sidebar-bottom{padding-bottom:clamp(8px,3vh,34px)}
  .sidebar-flag{width:calc(100% - 8px);max-height:13vh;object-fit:contain;object-position:left bottom}
}
@media(min-width:901px) and (max-width:1700px){
  .topbar{height:84px}.topbar-title h1{font-size:28px}.topbar-title p{font-size:15px}
  .menu-toggle svg{width:32px;height:32px}.bell-button svg{width:30px;height:30px}
  .user-avatar{width:46px;height:46px}.user-avatar svg{width:32px;height:32px}.user-meta strong,.user-meta small{font-size:14px}.top-divider{height:48px}
  .content{padding:16px 18px 14px}
  .dashboard-hero{min-height:200px;margin-bottom:16px}.hero-copy h2{font-size:32px;margin-bottom:12px}.hero-copy p{font-size:20px}.hero-button{height:40px;font-size:15px;margin-top:20px}
  .kpi-grid{gap:14px;margin-bottom:16px}.kpi-card{min-height:116px;padding:13px 14px;gap:14px}.kpi-icon{width:60px;height:60px;flex-basis:60px;border-radius:15px}.kpi-icon svg{width:36px;height:36px}.kpi-value{font-size:30px}.kpi-label{font-size:14.5px}.kpi-trend{left:92px;font-size:12.5px;bottom:10px}.kpi-spark{height:36px}
  .dashboard-insights{margin-bottom:18px}.evolution-panel,.notification-panel{padding:16px 18px 10px}.panel-title-row h2{font-size:17px}.chart-legend{font-size:13.5px}.chart-label{font-size:14px}
  .notif-row{min-height:58px}.notif-icon{width:40px;height:40px;flex-basis:40px}.notif-text strong{font-size:15px}.notif-text small{font-size:13px}.notif-pill{font-size:13.5px;padding:5px 14px}.notif-date{font-size:13px}.text-button{font-size:14px}
  .prevention-banner{height:100px}.prevention-banner>strong{font-size:20px}.prevention-icon svg{width:48px;height:56px}
}

/* Partie droite uniquement : réduction du zoom selon la hauteur pour garder le bandeau « Prévenir le paludisme » visible */
@media(min-width:901px) and (max-height:960px){.main-panel{zoom:.9}}
@media(min-width:901px) and (max-height:860px){.main-panel{zoom:.82}}
@media(min-width:901px) and (max-height:780px){.main-panel{zoom:.74}}
@media(min-width:901px) and (max-height:690px){.main-panel{zoom:.66}}

/* Textes du bas plus lisibles */
@media(min-width:901px){
  .prevention-banner{height:112px}
  .prevention-banner>strong{font-size:28px;max-width:52%}
  .prevention-icon svg{width:58px;height:68px}
  .sidebar-slogan{font-size:clamp(15px,2.3vh,21px)}
